# Optional AI provider (one is enough). Without a key the app still works:
# chat and amendment reading fall back to deterministic parsers + the rule editor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Postgres in production (Render sets this). Defaults to SQLite in ./data
DATABASE_URL=
# Path to the unzipped task kit, used by docker compose to auto-load master data locally
KIT_PATH=./kit
