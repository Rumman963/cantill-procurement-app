{
  "policy_id": "CORVO-PROC-POL-04",
  "version": "5.0",
  "effective_date": "2026-04-01",
  "title": "Corvo Engineering Procurement Policy (PR to PO)",
  "currency": "INR",
  "parameters": {
    "clubbing_creation_window_days": 14,
    "clubbing_need_by_window_days": 7,
    "valuation_po_lookback_days": 365,
    "preferred_list_lookback_days": 548,
    "consolidation_window_hours": 24
  },
  "clubbing": {
    "enabled": true,
    "match_on": ["item_code", "plant"],
    "never_club": ["new_item"]
  },
  "valuation_order": ["contract", "last_po", "standard_price"],
  "contracts": {
    "require_active_supplier": true,
    "selection": "lowest_rate_with_ceiling",
    "min_headroom_pct": 0
  },
  "excluded_supplier_statuses": ["Blocked", "Inactive"],
  "supplier_status_overrides": {},
  "preferred_suppliers": {
    "weights": {
      "frequency": 0.35,
      "recency": 0.25,
      "contract": 0.20,
      "on_time": 0.10,
      "quality": 0.10
    },
    "recency_bands": [
      {"within_days": 90, "score": 1.0},
      {"within_days": 365, "score": 0.5}
    ],
    "category_topup_weights": {"on_time": 0.5, "quality": 0.5}
  },
  "consolidation": {
    "enabled": true,
    "match_on": ["supplier_id", "plant", "route"]
  },
  "rules": [
    {
      "id": "1.2",
      "name": "New item (not in item master)",
      "when": {"all": [{"fact": "is_new_item", "op": "is_true"}]},
      "decision": "SOURCING_REQUEST",
      "route": "NEW_ITEM_SOURCING",
      "supplier": {"mode": "none"},
      "note": "Buyer finds suppliers; valued at requester's estimate"
    },
    {
      "id": "5.1",
      "name": "Capex item",
      "when": {"all": [{"fact": "item_type", "op": "eq", "value": "Capex"}]},
      "decision": "SOURCING_REQUEST",
      "route": "CAPEX_SOURCING",
      "supplier": {"mode": "suggest", "count": 5},
      "note": "Needs capex approval"
    },
    {
      "id": "5.2",
      "name": "Usable rate contract",
      "when": {"all": [{"fact": "contract_usable", "op": "is_true"}]},
      "decision": "PO",
      "route": "CONTRACT_PO",
      "supplier": {"mode": "contract"}
    },
    {
      "id": "5.3",
      "name": "Emergency up to 5 lakh with purchase history",
      "when": {"all": [
        {"fact": "is_emergency", "op": "is_true"},
        {"fact": "value", "op": "lte", "value": 500000},
        {"fact": "days_since_last_active_purchase", "op": "lte", "value": 365}
      ]},
      "decision": "PO",
      "route": "EMERGENCY_PO",
      "supplier": {"mode": "preferred", "rank": 1}
    },
    {
      "id": "5.4",
      "name": "Below 2 lakh with purchase history",
      "when": {"all": [
        {"fact": "value", "op": "lt", "value": 200000},
        {"fact": "days_since_last_active_purchase", "op": "lte", "value": 365}
      ]},
      "decision": "PO",
      "route": "SPOT_PO",
      "supplier": {"mode": "preferred", "rank": 1}
    },
    {
      "id": "5.5",
      "name": "Below 10 lakh",
      "when": {"all": [{"fact": "value", "op": "lt", "value": 1000000}]},
      "decision": "SOURCING_REQUEST",
      "route": "RFQ",
      "supplier": {"mode": "suggest", "count": 3}
    },
    {
      "id": "5.6",
      "name": "10 lakh or more",
      "when": {"all": []},
      "decision": "SOURCING_REQUEST",
      "route": "RFP",
      "supplier": {"mode": "suggest", "count": 5}
    }
  ]
}
